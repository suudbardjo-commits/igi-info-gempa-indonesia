{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_IGI_URL": "https://persons-test-loud-comic.trycloudflare.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_IGI_URL": "https://persons-test-loud-comic.trycloudflare.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
